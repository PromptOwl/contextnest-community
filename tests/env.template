# ContextNest Community Playwright Test Environment Configuration
# Copy this file into tests/.env/ and rename to: .local, .dev, or .prod
# Example: cp tests/env.template tests/.env/.local
# Select at runtime with: ENV=local npx playwright test --project=test-suite

# ===================
# Required Settings
# ===================

# Application URL (self-hosted community server)
BASE_URL=http://localhost:3838

# Primary Test Account (Required)
# The server must run in KEY auth mode with this user registered
# (or use an invited account's credentials).
TEST_ACCOUNT1_ALIAS=primary_user
TEST_ACCOUNT1_USER=your-email@example.com
TEST_ACCOUNT1_PW=your-password

# ===================
# Optional Settings
# ===================

# Secondary Test Account (Optional - for multi-user stewardship tests:
# e.g. primary as owner/reviewer, secondary as editor/viewer)
# TEST_ACCOUNT2_ALIAS=secondary_user
# TEST_ACCOUNT2_USER=another-email@example.com
# TEST_ACCOUNT2_PW=another-password

# Login method per account (default: manual). Set to "promptowl" to sign the
# account in through the PromptOwl device-auth flow — the USER/PW are then
# the PromptOwl account's credentials, not local ones.
# TEST_ACCOUNT1_METHOD=manual
# TEST_ACCOUNT2_METHOD=promptowl

# Vercel deployment-protection bypass for the PromptOwl popup
# (dev.promptowl.ai) — required for METHOD=promptowl against dev.
# VERCEL_BYPASS_SECRET=your-bypass-secret

# Playwright Settings (Optional)
# PLAYWRIGHT_TIMEOUT=30000
# PLAYWRIGHT_WORKERS=3
# PLAYWRIGHT_RETRIES=0
# PLAYWRIGHT_SLOW_MO=0

# Access-requests suite (CN-ACCESS-*): skips while the server under test doesn't
# serve /nests/:id/access-requests. Set to 1 once it is deployed everywhere so a
# server that stops serving it fails instead of skipping quietly.
# CN_EXPECT_ACCESS_REQUESTS=1

# Set to 1 once /hosted?embed=1 serves the viewer bridge on the target server:
# the annotations suite then fails instead of skipping when it is missing.
# CN_EXPECT_BRIDGE=1

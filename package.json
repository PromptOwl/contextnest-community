{
  "name": "@promptowl/contextnest-community",
  "version": "3.1.0",
  "description": "ContextNest Community Edition — self-hosted context governance server for AI workflows. Commercial software by Promptowl LLC.",
  "private": false,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Promptowl LLC",
    "email": "hoot@promptowl.ai",
    "url": "https://promptowl.ai"
  },
  "homepage": "https://promptowl.ai/contextnest/",
  "bugs": {
    "email": "hoot@promptowl.ai",
    "url": "https://promptowl.ai/contact-us/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PromptOwl/contextnest-community.git"
  },
  "keywords": [
    "contextnest",
    "promptowl",
    "context-governance",
    "llm",
    "mcp",
    "ai-workflows",
    "commercial"
  ],
  "main": "dist/index.js",
  "bin": {
    "contextnest-community": "dist/index.js"
  },
  "files": [
    "dist",
    "seeds",
    "LICENSE.md",
    "README.md",
    "CONFIGURATION.md",
    "API.md",
    "STEWARDSHIP.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:ui": "vite build --config ui/vite.config.ts --watch",
    "build": "tsup src/index.ts --format esm --dts --clean && npm run build:ui",
    "build:server": "tsup src/index.ts --format esm --dts --clean",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "lint:mcp-schemas": "node scripts/check-mcp-schemas.mjs",
    "eval:surfaces": "tsx scripts/eval-surfaces.ts",
    "site:export": "tsx scripts/site-export.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:playwright": "playwright test --project=test-suite",
    "prepublishOnly": "npm run build",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@aws-sdk/client-sesv2": "3.1139.0",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@promptowl/contextnest-engine": "^3.5.0",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.2",
    "dotenv": "^16.6.1",
    "hono": "4.13.13",
    "jose": "^6.2.3",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "markdown-it": "^14.2.0",
    "nodemailer": "9.0.3",
    "pg": "^8.13.1",
    "posthog-js": "^1.429.2",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",

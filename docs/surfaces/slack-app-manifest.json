{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Nest",
    "description": "Listens with judgement and proposes what's worth keeping to your governed nest. Nothing is saved until a person approves it.",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "nest",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/nest",
        "url": "https://YOUR-NEST-HOST/surfaces/slack/INSTALL_ID/commands",
        "description": "Remove Nest from this conversation, or turn your DM capture off/on",
        "usage_hint": "leave | invite | dm off | dm on",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://YOUR-NEST-HOST/surfaces/slack/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "im:read",
        "im:write",
        "reactions:read",
        "users:read",
        "users:read.email",
        "chat:write",
        "app_mentions:read",
        "im:history",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-NEST-HOST/surfaces/slack/INSTALL_ID/events",
      "bot_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "app_mention",
        "reaction_added",
        "member_joined_channel",
        "member_left_channel",
        "channel_left",
        "group_left",
        "channel_shared",
        "channel_unshared",
        "channel_archive",
        "group_archive",
        "channel_deleted",
        "group_deleted",
        "user_change",
        "app_home_opened",
        "app_uninstalled",
        "tokens_revoked"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR-NEST-HOST/surfaces/slack/INSTALL_ID/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}

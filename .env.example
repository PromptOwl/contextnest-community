# ContextNest Community Server Configuration
# Copy to .env and fill in your values

# Required: PromptOwl license key (get one at https://app.promptowl.ai)
PROMPTOWL_KEY=pk_your_key_here

# Server port (default: 3838)
PORT=3838

# Data directory for SQLite + vault files (default: ./data)
DATA_ROOT=./data

# Access mode (default: key)
#   key  = require API key (cnst_*) on every request
#          (default; use for any multi-user or internet-facing deployment)
#   open = no auth needed, anyone with network access can read/write
#          (opt in for local single-user or trusted VPN/LAN only)
AUTH_MODE=key

# PromptOwl API URL (default: https://app.promptowl.ai)
# PROMPTOWL_API_URL=https://app.promptowl.ai

# Restrict "Sign in with PromptOwl" (default: open)
#   open       = anyone may sign in with PromptOwl
#   admin-only = only the license owner (admin) may; everyone else uses
#                email/password. Admin opens the login page with ?admin=1.
#   disabled   = nobody may sign in with PromptOwl
# PROMPTOWL_SIGN_IN_GATE=open

# ── One-click SSO auto-login (OFFICIAL deployment ONLY) ──────────────────
# LEAVE THESE UNSET on self-hosted servers. They enable the one-click
# "Open Community" auto-login from PromptOwl, and only the single official
# ContextNest deployment is meant to set them. With the secret unset,
# GET /auth/sso returns 404 and the feature is disabled — self-hosted users
# keep using the manual device-code sign-in.
#
# OFFICIAL_COMMUNITY_SSO_SECRET must EXACTLY match the same-named secret on
# PromptOwl; it's the shared HMAC key used to verify the short-lived SSO
# ticket. PUBLIC_BASE_URL is this server's canonical external URL, checked
# against the ticket's audience so a ticket can't be replayed elsewhere.
# OFFICIAL_COMMUNITY_SSO_SECRET=
# PUBLIC_BASE_URL=https://community.promptowl.ai

# Telemetry (default: true — sends anonymous usage stats to PromptOwl)
# Set to "false" to opt out
# TELEMETRY_ENABLED=true

# Telemetry flush interval in ms (default: 3600000 = 1 hour)
# TELEMETRY_INTERVAL_MS=3600000

# Optional: custom logo URL shown in the UI header and login screen.
# Must start with https://, http://, or data:image/ — other schemes
# (file://, relative paths, javascript:) are rejected with a warning
# and the bundled ContextNest icon is used. The "ContextNest" wordmark
# and "Community" badge are unaffected.
LOGO_URL=https://example.com/my-logo.svg

# ContextNest Community Server Configuration
# Copy to .env and fill in your values

# Required: PromptOwl license key (get one at https://app.promptowl.ai)
PROMPTOWL_KEY=pk_your_key_here

# Server port (default: 3838)
PORT=3838

# Data directory for SQLite + vault files (default: ./data)
DATA_ROOT=./data

# Access mode (default: open)
#   open = no auth needed, anyone with network access can read/write
#          (recommended for VPN/internal deployments)
#   key  = require API key (cnst_*) on every request
AUTH_MODE=open

# PromptOwl API URL (default: https://app.promptowl.ai)
# PROMPTOWL_API_URL=https://app.promptowl.ai

# Telemetry (default: true — sends anonymous usage stats to PromptOwl)
# Set to "false" to opt out
# TELEMETRY_ENABLED=true

# Telemetry flush interval in ms (default: 3600000 = 1 hour)
# TELEMETRY_INTERVAL_MS=3600000

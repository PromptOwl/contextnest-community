# ContextNest Community Server Configuration
# Copy to .env and fill in your values

# Required: PromptOwl license key (get one at https://app.promptowl.ai)
PROMPTOWL_KEY=pk_your_key_here

# Server port (default: 3838)
PORT=3838

# Data directory for SQLite + vault files (default: ./data)
DATA_ROOT=./data

# Root directory for nest vault files (default: $DATA_ROOT/nests)
# Override to store nests separately from the SQLite DB — e.g. a Cloud Storage
# (GCS) volume mount on Cloud Run, keeping the DB on DATA_ROOT off the mount.
# The app does NOT move existing files: copy $DATA_ROOT/nests/* to the new root
# before switching, or existing nests will look empty. On a GCS mount also set
# DRIFT_SCAN_INTERVAL_MS=0 and run a single instance (FUSE has no file locking).
# NEST_STORAGE_ROOT=/mnt/nests


# ── Database backend (default: sqlite) ──────────────────────────────────
# Leave unset to use SQLite (the file at DATA_ROOT/community.db). Set these
# to use PostgreSQL / Cloud SQL instead — needed for Cloud Run and other
# deployments where local disk isn't durable. NOTE: this covers the metadata
# DB only; the document vault under DATA_ROOT/nests still needs persistent
# storage (see CONFIGURATION.md).
#
#   DB_DRIVER=postgres          # or leave unset; inferred from DATABASE_URL
#
# TCP connection string:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# Cloud SQL via the Auth Proxy unix socket (recommended on Cloud Run):
#   CLOUD_SQL_CONNECTION_NAME=project:region:instance
#   DB_USER=contextnest
#   DB_PASSWORD=your_password
#   DB_NAME=contextnest
#
# Optional Postgres tuning:
#   DB_POOL_MAX=10              # max pool connections (Cloud SQL tiers cap this)
#   DB_SSL=true                 # require TLS on a TCP connection
#   DB_SSL_CA=/path/to/ca.pem   # custom CA for verify-ca/verify-full

# Access mode (default: key)
#   key  = require API key (cnst_*) on every request
#          (default; use for any multi-user or internet-facing deployment)
#   open = no auth needed, anyone with network access can read/write
#          (opt in for local single-user or trusted VPN/LAN only)
AUTH_MODE=key

# PromptOwl API URL (default: https://app.promptowl.ai)
# PROMPTOWL_API_URL=https://app.promptowl.ai

# Restrict "Sign in with PromptOwl" (default: open)
#   open       = anyone may sign in with PromptOwl
#   admin-only = only the license owner (admin) may; everyone else uses
#                email/password. Admin opens the login page with ?admin=1.
#   disabled   = nobody may sign in with PromptOwl
# PROMPTOWL_SIGN_IN_GATE=open

# Email + password sign-in mode (default: open)
#   open        = anyone may log in and self-register
#   invite-only = existing/invited users may log in, but brand-new
#                 self-registration is refused. Admin provisions accounts
#                 (invite / share / steward) and shares the password.
#   disabled    = no email/password sign-in at all (PromptOwl only)
# Independent of PROMPTOWL_SIGN_IN_GATE. Can't be "disabled" while
# PROMPTOWL_SIGN_IN_GATE=disabled (that would leave no way to log in).
# MANUAL_SIGN_IN=open

# ── One-click SSO auto-login (OFFICIAL deployment ONLY) ──────────────────
# LEAVE THESE UNSET on self-hosted servers. They enable the one-click
# "Open Community" auto-login from PromptOwl, and only the single official
# ContextNest deployment is meant to set them. With the secret unset,
# GET /auth/sso returns 404 and the feature is disabled — self-hosted users
# keep using the manual device-code sign-in.
#
# OFFICIAL_COMMUNITY_SSO_SECRET must EXACTLY match the same-named secret on
# PromptOwl; it's the shared HMAC key used to verify the short-lived SSO
# ticket. PUBLIC_BASE_URL is this server's canonical external URL, checked
# against the ticket's audience so a ticket can't be replayed elsewhere.
# OFFICIAL_COMMUNITY_SSO_SECRET=
# PUBLIC_BASE_URL=https://community.promptowl.ai

# ── Public docs sites ────────────────────────────────────────────────────
# Serve a public Reader Mode nest as a static docs site on its own domain
# (host=nestId, comma-separated). Without it, docs sites live at /d/<slug>.
# DOCS_SITES=docs.example.com=<nestId>

# ── Single sign-on (OIDC) ────────────────────────────────────────────────
# Generic OpenID Connect sign-in — works with Microsoft Entra ID, Google,
# Okta, Keycloak, or any spec-compliant issuer. Unrelated to the official
# one-click SSO above. All of this is also editable at runtime from
# Settings → Single sign-on (no restart), so setting it here is optional —
# it's for operators who prefer config-as-code. See CONFIGURATION.md →
# "Single sign-on (OIDC)" for the Entra ID walkthrough.
#
# Register this redirect URI in your IdP app registration:
#   https://<your-server>/auth/oidc/callback
# Set PUBLIC_BASE_URL above when OIDC is on — it pins that URI instead of
# deriving it from the request's Host header.
# OIDC_ENABLED=false
#
# Issuer — https:// only, must serve /.well-known/openid-configuration.
#   Entra:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google: https://accounts.google.com
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# Comma-separated email-domain allowlist. EMPTY ALLOWS ANY DOMAIN the issuer
# asserts — with a consumer/multi-tenant issuer that's the whole internet.
# Set it, or turn OIDC_AUTO_PROVISION off.
# OIDC_ALLOWED_DOMAINS=acme.com, contractors.acme.com
#
# Create an account on first SSO sign-in (default: true). "false" = only
# already-invited/registered emails may sign in; others bounce not_invited.
# OIDC_AUTO_PROVISION=true

# ── Agent SSO / token-exchange (POST /auth/token-exchange) ──────────────────
# Lets an external agent, acting for a user your IdP (Microsoft Entra / Google)
# already authenticated, exchange that IdP's ID token for a short-lived scoped
# MCP bearer — no second login. SECURITY-CRITICAL; OFF by default. Reuses
# OIDC_ALLOWED_DOMAINS + OIDC_AUTO_PROVISION for who's allowed / JIT.
#
# Master switch (must be "true", plus MCP_SIGNING_SECRET + a provider, or the
# endpoint returns 404):
# SSO_TOKEN_EXCHANGE_ENABLED=false
#
# The secret THIS server signs its minted MCP tickets with. Distinct from the
# PromptOwl shared secret so self-hosted works. Long random string; keep secret.
# MCP_SIGNING_SECRET=
#
# Minted-ticket lifetime, seconds (clamped 30–3600, default 300).
# MCP_TOKEN_TTL_SECONDS=300
#
# Microsoft Entra: enable + the app (client) id inbound tokens must target
# (audience) + the tenant id (builds issuer login.microsoftonline.com/<tenant>/v2.0).
# MS_TOKEN_EXCHANGE_ENABLED=false
# MS_CLIENT_ID=
# MS_TENANT_ID=
#
# Google: enable + the OAuth client id inbound tokens must target (audience).
# Issuer is fixed (accounts.google.com).
# GOOGLE_TOKEN_EXCHANGE_ENABLED=false
# GOOGLE_CLIENT_ID=
#
# HARDENING: set OIDC_ALLOWED_DOMAINS above. This is ENFORCED, not advice —
# with auto-provision on and an empty allowlist every exchange for an unknown
# email is refused (no_account), because otherwise anyone with an account at
# that IdP (Google = the whole internet) could sign themselves up and mint a
# token. Also set PUBLIC_BASE_URL (top of file) so minted tokens are
# audience-bound to this server. Clearing MCP_SIGNING_SECRET is the revocation
# switch — turning the master flag off stops minting but leaves already-issued
# tokens valid until they expire.

# Telemetry (default: true — sends anonymous usage stats to PromptOwl)
# Set to "false" to opt out
# TELEMETRY_ENABLED=true

# Telemetry flush interval in ms (default: 3600000 = 1 hour)
# TELEMETRY_INTERVAL_MS=3600000

# Optional: custom logo URL shown in the UI header and login screen.
# Must start with https://, http://, or data:image/ — other schemes
# (file://, relative paths, javascript:) are rejected with a warning
# and the bundled ContextNest icon is used. The "ContextNest" wordmark
# and "Community" badge are unaffected.
LOGO_URL=https://example.com/my-logo.svg

# ── Import teams from PromptOwl ────────────────────────────────────────
# Lets users who signed in with PromptOwl pull their PromptOwl teams in as
# local teams. OFF by default — an operator opts in here or from Settings.
# When off, the /teams/promptowl routes 404 and the UI hides the panel.
# PROMPTOWL_TEAMS_ENABLED=true

# ── Workflow plane ("turing" track) ────────────────────────────────────
# Typed edges, edge-type registry, and (soon) governed runs. OFF by
# default — optional feature; also toggleable from Settings in the UI.
# FEATURE_WORKFLOW_PLANE=true

# Sub-agent runs: lets a workflow run spawn nested runs (recursion). Gated
# SEPARATELY from the plane because recursion is the risky surface. Off by
# default; requires FEATURE_WORKFLOW_PLANE too. SUBAGENT_MAX_DEPTH bounds the
# call tree (clamped 1..32, default 8).
# FEATURE_SUBAGENT_RUNS=true
# SUBAGENT_MAX_DEPTH=8
# SUBAGENT_MAX_CHILDREN bounds fan-out (tree width); RUN_MAX_STEPS bounds a
# run's step log. Together with depth they cap total work a runner can drive.
# SUBAGENT_MAX_CHILDREN=16
# RUN_MAX_STEPS=10000

# ── Slack connector ────────────────────────────────────────────────────
# Optional: post governance events (review requested / approved / rejected,
# nest shared) to a Slack channel. Create an incoming webhook in Slack and
# paste its URL here — or set it from Settings in the web UI. The URL
# embeds a secret; https only. Empty/unset = connector off.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ── Email connector ────────────────────────────────────────────────────
# Optional: send the same governance events over SMTP. Connection URL with
# credentials inline (smtp:// or smtps:// only), plus From and recipient(s).
# Empty/unset SMTP_URL = connector off. Also editable from Settings in the UI.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or send through AWS SES via the AWS SDK instead of SMTP. Leave the keys
# unset to use the server's IAM role / default AWS credential chain.
# EMAIL_PROVIDER=ses
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=AKIA...
# SES_SECRET_ACCESS_KEY=...
# NOTIFY_EMAIL_FROM=nest@yourcompany.com
# NOTIFY_EMAIL_TO=team@yourcompany.com,ops@yourcompany.com

# How long notification events buffer per nest before flushing as one
# message (milliseconds). Bursts — e.g. sharing a nest with a whole team —
# collapse into a single digest instead of one message per event.
# NOTIFY_DEBOUNCE_MS=15000

{
  "title": "ContextNest Community",
  "uid": "contextnest-community",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "label": "Prometheus" }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests / s by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (route) (rate(contextnest_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency by route",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(contextnest_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx / s by route",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (route) (rate(contextnest_http_request_duration_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "MCP tool calls / s (503 = vault busy)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (tool, status) (rate(contextnest_mcp_tool_duration_seconds_count[5m]))", "legendFormat": "{{tool}} {{status}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Postgres pool",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "contextnest_db_pool_total", "legendFormat": "open" },
        { "expr": "contextnest_db_pool_idle", "legendFormat": "idle" },
        { "expr": "contextnest_db_pool_waiting", "legendFormat": "waiting" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Memory and event-loop lag",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "contextnest_process_resident_memory_bytes", "legendFormat": "RSS bytes" },
        { "expr": "contextnest_nodejs_eventloop_lag_p99_seconds", "legendFormat": "event-loop lag p99 (s)" }
      ]
    }
  ]
}

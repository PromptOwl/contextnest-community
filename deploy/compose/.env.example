# Copy to .env and fill in. Every variable here is also passed to the server,
# so any setting from CONFIGURATION.md can be added below.

# --- Required ---------------------------------------------------------------
# The DNS name pointing at this VM. Caddy gets an HTTPS certificate for it.
CONTEXTNEST_HOST=nest.example.com
# Database password. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# --- Recommended ------------------------------------------------------------
# Let's Encrypt account email, for certificate expiry notices.
ACME_EMAIL=
# Pin a release instead of tracking latest, e.g. 2.3.0.
CONTEXTNEST_VERSION=latest
# Master key for credentials the server stores encrypted. Set once, never change.
# Generate one: openssl rand -base64 32
SECRETS_KEY=

# --- Optional ---------------------------------------------------------------
# PromptOwl license key (pk_...). Without one the server runs on the Free tier;
# it can also be installed from the browser.
PROMPTOWL_KEY=
# Outbound email (invites, review requests, mentions), e.g. smtp://user:pass@host:587
# SMTP_URL=
# NOTIFY_EMAIL_FROM=
# Single sign-on: see CONFIGURATION.md → Single sign-on (OIDC).
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Logs and metrics for your monitoring stack.
# LOG_FORMAT=json
# METRICS_ENABLED=true
